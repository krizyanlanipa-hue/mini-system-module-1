# HELPER FUNCTIONS (used throughout the program)
def get_float(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return float(input())
       except ValueError:
           print("  >> Invalid input. Please type a whole number (e.g., 5, -3, 0).")
       except EOFError:
           print("\n  >> No input received. Existing program.")
           raise SystemExist


def safe_input(prompt):
    try:
        print(prompt, end="", flush=True)
        sys.stdout.flush()
        return input()
    except EOFError:
        print("\n >> No input received. Existing program.")
        raise SystemExist
       

